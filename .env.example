# Local testing only — GitHub Actions reads these from repo secrets instead.
#
#   1. cp .env.example .env
#   2. Get both values from claude.ai/code/routines → your routine → API trigger
#   3. ./scripts/trigger.sh
#
# .env is gitignored. Never commit the real one.

CLAUDE_ROUTINE_URL=paste-the-endpoint-url-here
CLAUDE_ROUTINE_TOKEN=paste-the-bearer-token-here
